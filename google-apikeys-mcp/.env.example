# ---------------------------------------------------------------------------
# google-apikeys-mcp — every variable this server reads.
# Copy to .env and fill in. .env is gitignored; never commit a real one.
#
# Same project and same scoped service account as gcp-iam-mcp — one credential
# surface across both servers.
# ---------------------------------------------------------------------------

# REQUIRED. The GCP project whose API keys this server manages.
GCP_PROJECT_ID=haorgrix-mcp

# The API Keys API only serves "global" today. Configurable, validated.
# APIKEYS_LOCATION=global

# Path to a service-account JSON key, or omit for Application Default
# Credentials. Relative paths resolve against the process working directory,
# so register through a launcher that chdirs into this folder.
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ---------------------------------------------------------------------------
# Safety gates — layer 1. Tools are ABSENT from tools/list when their flag is
# off, not merely refused at call time.
# ---------------------------------------------------------------------------

# Registers apikeys_create and apikeys_update_restrictions. Default false.
# APIKEYS_ALLOW_WRITES=false

# Registers apikeys_delete and apikeys_undelete. Requires APIKEYS_ALLOW_WRITES;
# the server refuses to boot with destructive on and writes off. Default false.
# APIKEYS_ALLOW_DESTRUCTIVE=false

# ---------------------------------------------------------------------------
# Safety gates — the denylist. Key ids refused by apikeys_delete whatever every
# flag says. Checked before flags, before confirm, before dry_run.
# Comma-separated key ids. Empty by default — populate it with the id of any
# key a live app depends on.
# ---------------------------------------------------------------------------
# APIKEYS_PROTECTED_KEYS=

# ---------------------------------------------------------------------------
# Secrets. There is deliberately NO flag that returns a key string in a
# response: a tool result lands in the conversation transcript and stays there.
# apikeys_create writes the key string to a 0600 file and returns the path plus
# a fingerprint. Delete each file once the key is where it belongs.
# ---------------------------------------------------------------------------
# APIKEYS_SECRET_OUT_DIR=./secrets

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
# APIKEYS_AUDIT_LOG=audit.jsonl   # append-only JSONL, local only, gitignored
# APIKEYS_TIMEOUT_MS=30000        # per-request timeout, 1000-120000
# APIKEYS_MAX_RETRIES=3           # retries on 429/5xx only. A 403 never retries.
# APIKEYS_PAGE_LIMIT=100          # default cap on apikeys_list, 1-500
