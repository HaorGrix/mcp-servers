BREVO_API_KEY=xkeysib-your-key-here
# Optional. When set, every send tool refuses to fire unless the campaign's
# sender email matches. Guards against a repeat of the gmail.com sender bug.
# BREVO_ENFORCE_SENDER=abir@podiumtutoring.com
# Optional override, defaults to https://api.brevo.com/v3
# BREVO_BASE_URL=https://api.brevo.com/v3
# Enterprise controls
# BREVO_DRY_RUN=1          # refuse every write, rehearse safely
# BREVO_TIMEOUT_MS=30000   # per-request timeout, 1000-120000
# BREVO_MAX_RETRIES=3      # retries on 429/5xx, 0-10
# BREVO_RPS=8              # client-side rate limit, 1-100
# BREVO_AUDIT_LOG=audit.jsonl
