# ---------------------------------------------------------------------------
# resend-mcp — every variable this server reads.
# Copy to .env and fill in. .env is gitignored; never commit a real one.
# ---------------------------------------------------------------------------

# REQUIRED. Resend API key. full_access is needed for key and domain management.
RESEND_API_KEY=re_your_key_here

# RESEND_BASE_URL=https://api.resend.com

# ---------------------------------------------------------------------------
# Safety gates — layer 1. Tools are ABSENT from tools/list when their flag is
# off, not merely refused at call time. Note resend_send_email is a WRITE tool:
# with the default flags this server cannot send mail at all.
# ---------------------------------------------------------------------------

# RESEND_ALLOW_WRITES=false
# RESEND_ALLOW_DESTRUCTIVE=false   # requires RESEND_ALLOW_WRITES

# ---------------------------------------------------------------------------
# THE PERMANENT RULE. zennpsi@gmail.com is never a recipient and never a
# sender. It is enforced server-side before any request reaches Resend, and it
# CANNOT be configured away: setting this variable adds to the list, it does
# not replace the built-in entry. Setting it as RESEND_ENFORCE_SENDER refuses
# at boot.
#
# A send tool is exactly what breaches a never-contact rule by accident, which
# is why this is code rather than a note in a doc.
# ---------------------------------------------------------------------------
# RESEND_BLOCKED_RECIPIENTS=someone@example.com

# When set, every send refuses unless the from address matches exactly.
# Mirrors brevo-mcp's BREVO_ENFORCE_SENDER.
# RESEND_ENFORCE_SENDER=noreply@haorgrix.com

# Domain names refused by resend_delete_domain whatever the flags say.
# Populate with any domain a live app sends from. Comma-separated.
# RESEND_PROTECTED_DOMAINS=haorgrix.com

# ---------------------------------------------------------------------------
# Key identification. Resend NEVER exposes a key value, so a key can only be
# identified by name plus creation date. Keys created before this date are
# flagged suspect by resend_list_api_keys. Defaults to the 2026-06-24 breach.
# ---------------------------------------------------------------------------
# RESEND_BREACH_DATE=2026-06-24

# ---------------------------------------------------------------------------
# Secrets. resend_create_api_key writes the new token to a 0600 file and
# returns the path plus a fingerprint. Resend returns a key value exactly once
# and never again, and a tool result lands in the transcript — so it is never
# in a response.
# ---------------------------------------------------------------------------
# RESEND_SECRET_OUT_DIR=./secrets

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
# RESEND_AUDIT_LOG=audit.jsonl
# RESEND_TIMEOUT_MS=30000
# RESEND_MAX_RETRIES=3
# RESEND_PAGE_LIMIT=100
