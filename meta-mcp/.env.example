# System User token from Business Manager (never expires). Never commit the real .env.
META_ACCESS_TOKEN=
# Graph API version
META_API_VERSION=v23.0
# Default asset ids so tools can omit them
META_BUSINESS_ID=
META_PAGE_ID=
META_IG_USER_ID=
META_WABA_ID=
META_APP_ID=
META_AD_ACCOUNT_ID=
# App secret: only needed for webhook signature checks and appsecret_proof
META_APP_SECRET=
# Set to false to make the whole server read-only
META_ALLOW_WRITES=true
