{
  "name": "meta-mcp",
  "version": "1.0.0",
  "description": "Full-access MCP server for the Meta business ecosystem: Business Manager, Pages, Instagram, Messenger, WhatsApp, Leads, Catalog, Webhooks, Ads",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "meta-mcp": "dist/index.js" },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=20.0.0" }
}
