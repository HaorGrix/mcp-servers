# WordPress site URL (no trailing slash)
WORDPRESS_URL=https://fernhillbd.com

# WordPress username
WORDPRESS_USERNAME=musfiqur

# Application Password generated in WP Admin → Users → Profile → Application Passwords
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# WooCommerce REST API keys (generate in WP Admin → WooCommerce → Settings → Advanced → REST API)
# Only required for wc_* tools; leave blank if WooCommerce not installed
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare edge cache purge (optional — only for wp_purge_cloudflare)
# API token needs the "Zone.Cache Purge" permission; zone ID is on the domain's
# Cloudflare Overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
