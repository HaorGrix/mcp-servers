# ---------------------------------------------------------------------------
# openrouter-mcp — every variable this server reads.
# Copy to .env and fill in. .env is gitignored; never commit a real one.
# ---------------------------------------------------------------------------

# REQUIRED. The PROVISIONING key from openrouter.ai/settings/provisioning-keys.
# NOT an inference key — an inference key cannot manage other keys, and the
# server refuses to boot with a message saying so.
OPENROUTER_PROVISIONING_KEY=sk-or-prov-your-key-here

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Safety gates — layer 1. Tools are ABSENT from tools/list when their flag is
# off, not merely refused at call time.
# ---------------------------------------------------------------------------
# OPENROUTER_ALLOW_WRITES=false
# OPENROUTER_ALLOW_DESTRUCTIVE=false   # requires OPENROUTER_ALLOW_WRITES

# Key hashes refused by openrouter_delete_key whatever the flags say.
# Populate with the hash of any key a live app depends on. Comma-separated.
# OPENROUTER_PROTECTED_KEYS=

# ---------------------------------------------------------------------------
# Spend safety. A key with no limit can spend the entire account balance.
# When set, openrouter_create_key applies this ceiling to any key created
# without an explicit limit, and openrouter_list_keys flags every uncapped key
# it finds.
# ---------------------------------------------------------------------------
# OPENROUTER_DEFAULT_KEY_LIMIT=25

# ---------------------------------------------------------------------------
# Secrets. openrouter_create_key writes the new key to a 0600 file and returns
# the path plus a fingerprint. OpenRouter returns a key value exactly once, and
# a tool result lands in the conversation transcript — so it is never in a
# response.
# ---------------------------------------------------------------------------
# OPENROUTER_SECRET_OUT_DIR=./secrets

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
# OPENROUTER_AUDIT_LOG=audit.jsonl
# OPENROUTER_TIMEOUT_MS=30000
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_PAGE_LIMIT=100
