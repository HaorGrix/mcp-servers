{
  "name": "hetzner-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing the Hetzner Cloud API — servers, firewalls, snapshots, SSH keys, audit. Read-only by default; writes require a separate token and destructive calls require explicit confirmation.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
