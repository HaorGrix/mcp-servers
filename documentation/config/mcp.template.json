      }
    },
    "meta-business": {
      "command": "node",
      "args": ["__MCP_ROOT__/meta-business-mcp/dist/index.js"],
      "env": {
        "META_ACCESS_TOKEN": "",
        "META_ALLOW_WRITES": "false"
      }
    },
    "wordpress-fernhillbd": {
      "command": "node",
      "args": ["__MCP_ROOT__/wordpress-mcp/dist/index.js"],
      "env": {
        "WORDPRESS_URL": "https://fernhillbd.com",
        "WORDPRESS_USERNAME": "musfiqur",
        "WORDPRESS_APP_PASSWORD": "",
        "WC_CONSUMER_KEY": "",
        "WC_CONSUMER_SECRET": ""
