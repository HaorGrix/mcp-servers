# ---------------------------------------------------------------------------
# neon-mcp — every variable this server reads.
# Copy to .env and fill in. .env is gitignored; never commit a real one.
# ---------------------------------------------------------------------------

# REQUIRED. Neon account-level API key (owner). Create at
# console.neon.tech -> Account settings -> API keys.
NEON_API_KEY=napi_your_key_here

# NEON_BASE_URL=https://console.neon.tech/api/v2

# ---------------------------------------------------------------------------
# Safety gates — layer 1. Tools are ABSENT from tools/list when their flag is
# off, not merely refused at call time.
# ---------------------------------------------------------------------------

# Registers create/start/suspend tools. Default false.
# NEON_ALLOW_WRITES=false

# Registers neon_reset_role_password, neon_delete_project and
# neon_delete_branch. Requires NEON_ALLOW_WRITES; the server refuses to boot
# with destructive on and writes off. Default false.
#
# Note reset_role_password is classed DESTRUCTIVE, not write: Neon replaces the
# password atomically, so the old one dies the instant it runs and every app
# using it is down until redeployed. There is no create-before-delete option.
# NEON_ALLOW_DESTRUCTIVE=false

# ---------------------------------------------------------------------------
# Safety gates — the denylist. Project ids refused by every destructive tool
# whatever the flags say. Checked before flags, before confirm, before dry_run.
#
# Populate this with any project a live app depends on. The reiva database
# lives on the project whose endpoint host starts ep-shy-bread-am1akxy2.
# Comma-separated.
# ---------------------------------------------------------------------------
# NEON_PROTECTED_PROJECTS=

# ---------------------------------------------------------------------------
# Secrets. A Neon connection URI CONTAINS THE ROLE PASSWORD, so
# neon_get_connection_uri and neon_reset_role_password write to a 0600 file and
# return the path plus a fingerprint. There is no flag to make them return the
# value — a tool result lands in the conversation transcript and stays there.
# ---------------------------------------------------------------------------
# NEON_SECRET_OUT_DIR=./secrets

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
# NEON_AUDIT_LOG=audit.jsonl   # append-only JSONL, local only, gitignored
# NEON_TIMEOUT_MS=30000        # per-request timeout, 1000-120000
# NEON_MAX_RETRIES=3           # retries on 429/5xx only, 0-10
# NEON_PAGE_LIMIT=100          # default cap on list tools, 1-500
