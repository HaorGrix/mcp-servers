# Namecheap API credentials — https://ap.www.namecheap.com/settings/tools/apiaccess/
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# Usually identical to NAMECHEAP_API_USER; differs only for reseller sub-accounts.
NAMECHEAP_USERNAME=
# Must be whitelisted in the Namecheap API settings, or every call is rejected.
NAMECHEAP_CLIENT_IP=
# "sandbox" targets api.sandbox.namecheap.com. Anything else uses production.
NAMECHEAP_ENV=production
# Writes are refused unless this is exactly "true".
NAMECHEAP_ALLOW_WRITES=false
