# Zoho mailbox to read. This is the address that receives campaign replies.
ZOHO_USER=abir@podiumtutoring.com

# App-specific password, NOT the account login password.
# Create one at: Zoho Mail -> Settings -> Security -> App Passwords.
# IMAP must also be enabled: Settings -> Mail Accounts -> IMAP Access -> Enable.
ZOHO_APP_PASSWORD=xxxxxxxxxxxx

# IMAP host. zoho.com for most accounts; zoho.eu / zoho.in for those regions.
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993

# Optional. When set, this server refuses every write/delete IMAP flag change.
# Read-only is the safe default for a reply-monitoring tool.
ZOHO_READ_ONLY=1
