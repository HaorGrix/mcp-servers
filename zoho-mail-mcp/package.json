{
  "name": "zoho-mail-mcp",
  "version": "1.0.0",
  "description": "MCP server for reading a Zoho mailbox over IMAP \u2014 list, search, read, and surface campaign replies",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/mailparser": "^3.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/nodemailer": "^6.4.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
