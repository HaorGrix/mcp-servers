# Required. Meta access token with ads_read (plus ads_management for write tools).
# Prefer a System User token: Business Settings -> System Users -> Generate token.
META_ACCESS_TOKEN=PLACEHOLDER_INSERT_YOUR_META_ACCESS_TOKEN_HERE

# Optional. Graph API version. Bump when Meta deprecates the current one.
META_API_VERSION=v23.0

# Optional tuning.
META_TIMEOUT_MS=60000
META_MAX_RETRIES=4
META_PAGE_LIMIT=200
META_MAX_PAGES=200

# Write tools (create_campaign, create_adset, update_status) are OFF unless this is
# exactly "true". Leave unset for a read-only, spend-safe deployment.
META_ALLOW_WRITES=false
