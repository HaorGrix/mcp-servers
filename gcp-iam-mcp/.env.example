# ---------------------------------------------------------------------------
# gcp-iam-mcp — every variable this server reads.
# Copy to .env and fill in. .env is gitignored; never commit a real one.
# ---------------------------------------------------------------------------

# REQUIRED. The GCP project this server manages.
GCP_PROJECT_ID=haorgrix-mcp

# Path to a service-account JSON key. Omit to use Application Default
# Credentials instead. Relative paths resolve against the process working
# directory, so register this server through a launcher that chdirs into the
# server folder — see scripts/mcp-launch.mjs.
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ---------------------------------------------------------------------------
# Safety gates — layer 1. Tools are ABSENT from tools/list when their flag is
# off, not merely refused at call time, so they cannot be reached by guessing
# a tool name.
# ---------------------------------------------------------------------------

# Registers create/enable/disable tools. Default false.
# GCP_ALLOW_WRITES=false

# Registers the delete tools. Requires GCP_ALLOW_WRITES=true; the server refuses
# to boot with destructive on and writes off. Default false.
# GCP_ALLOW_DESTRUCTIVE=false

# Lets gcp_create_sa_key return the private key material in its response.
# Default false, and false is the right default: anything returned here enters
# the model context and can end up in a transcript or a paste. Google issues
# the material once and can never re-read it, so prefer downloading from the
# console over turning this on.
# GCP_ALLOW_SECRET_READ=false

# ---------------------------------------------------------------------------
# Safety gates — the denylist. Refused outright by destructive tools whatever
# every flag says. Flags protect against the wrong mode; this protects against
# the right mode and the wrong id.
#
# Ships protecting the service account that BOTH google-analytics-mcp and
# google-search-console-mcp authenticate on — deleting it dark-outs both.
# Comma-separated.
# ---------------------------------------------------------------------------
# GCP_PROTECTED_SERVICE_ACCOUNTS=search-console-mcp@haorgrix-mcp.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------

# Append-only JSONL journal of every write and destructive call. Local file
# only, gitignored, never shipped off-box.
# GCP_AUDIT_LOG=audit.jsonl

# GCP_TIMEOUT_MS=30000   # per-request timeout, 1000-120000
# GCP_MAX_RETRIES=3      # retries on 429/5xx only, 0-10. A 403 never retries.
# GCP_PAGE_LIMIT=100     # default cap on list_* results, 1-500
