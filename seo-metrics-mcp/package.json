{
  "name": "seo-metrics-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing SEO authority and keyword data from Open PageRank, Ahrefs API v3, and Keywords Everywhere. Read-only. Typed tools for the common calls plus generic passthroughs so the full API surface of each provider is reachable.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
